{
  "schema_version": 1,
  "release_gates": [
    {
      "id": "validator-tests",
      "name": "Run validator tests",
      "command": "uv run --locked pytest",
      "working_directory": "tools/coad-validator",
      "required": true
    },
    {
      "id": "coad-check",
      "name": "Check COAD methodology compliance",
      "command": "uv run --locked coad check ../.. --schema-dir ../../schema",
      "working_directory": "tools/coad-validator",
      "required": true
    },
    {
      "id": "json-schema-syntax",
      "name": "Validate JSON schemas",
      "command": "jq empty schema/*.json schema/reports/*.json",
      "working_directory": ".",
      "required": true
    }
  ]
}
