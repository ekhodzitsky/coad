{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/reports/check-report.schema.json",
  "title": "COAD Check Report",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "status",
    "agent_status",
    "blocking_checks",
    "next_actions",
    "checks",
    "issues"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": ["pass", "fail"]
    },
    "agent_status": {
      "enum": ["pass", "continue", "repair_required", "blocked"]
    },
    "blocking_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repair_action"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["name", "producer", "required", "ok", "status"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "issue": {
      "type": "object",
      "required": ["severity", "path", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repair_action": {
      "type": "object",
      "required": [
        "phase",
        "severity",
        "source_check",
        "target_path",
        "target_field",
        "expected_kind",
        "action",
        "action_code",
        "minimal_fix",
        "blocks_completion",
        "rerun"
      ],
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": ["orient", "scope", "execute", "prove", "update_knowledge", "handoff"]
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "source_check": {
          "type": "string",
          "minLength": 1
        },
        "target_path": {
          "type": "string"
        },
        "target_field": {
          "type": "string",
          "minLength": 1
        },
        "expected_kind": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "action_code": {
          "type": "string",
          "pattern": "^coad\\.repair\\."
        },
        "minimal_fix": {
          "type": "string",
          "minLength": 1
        },
        "blocks_completion": {
          "type": "boolean"
        },
        "rerun": {
          "const": "coad check . --format json"
        }
      }
    }
  }
}
