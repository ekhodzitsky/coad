{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/reports/proof-matrix.schema.json",
  "title": "COAD Proof Matrix",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "ok", "ready", "status", "contracts", "issues"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "ready": {
          "const": false
        },
        "status": {
          "const": "invalid"
        },
        "contracts": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "ok", "ready", "status", "contracts", "goals"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "ready": {
          "type": "boolean"
        },
        "status": {
          "enum": ["ready", "not_ready"]
        },
        "contracts": {
          "type": "integer",
          "minimum": 0
        },
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goal"
          }
        }
      }
    }
  ],
  "$defs": {
    "goal": {
      "type": "object",
      "required": ["goal_id", "path", "ready", "status", "blockers", "tasks"],
      "additionalProperties": false,
      "properties": {
        "goal_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "ready": {
          "type": "boolean"
        },
        "status": {
          "enum": ["ready", "not_ready"]
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "path",
        "change_class",
        "ready",
        "status",
        "blockers",
        "proofs"
      ],
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "change_class": {
          "type": "string",
          "minLength": 1
        },
        "ready": {
          "type": "boolean"
        },
        "status": {
          "enum": ["ready", "not_ready"]
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          }
        },
        "proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "required": [
        "proof_id",
        "command",
        "kind",
        "target",
        "proof_contract",
        "evidence",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "proof_id": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string"
        },
        "proof_contract": {
          "oneOf": [
            {
              "$ref": "#/$defs/contract_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": ["pass", "missing_evidence"]
        }
      }
    },
    "contract_ref": {
      "type": "object",
      "required": ["id", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["status", "source"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blocker": {
      "type": "object",
      "required": ["kind", "id", "path", "message"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "required": ["severity", "path", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
