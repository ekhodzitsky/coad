{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/reports/ledger-report.schema.json",
  "title": "COAD Ledger Report",
  "type": "object",
  "required": ["schema_version", "ok", "status", "contracts", "ledgers", "issues"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": ["verified", "ledger_issues", "invalid"]
    },
    "contracts": {
      "type": "integer",
      "minimum": 0
    },
    "ledgers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ledger"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "ledger": {
      "type": "object",
      "required": ["path", "run_id", "goal_id", "entries"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "goal_id": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "event_id",
        "task_id",
        "status",
        "agent_id",
        "role",
        "wave",
        "required_proof_commands",
        "passing_proof_commands",
        "proof_status"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "wave": {
          "type": "integer",
          "minimum": 0
        },
        "required_proof_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "passing_proof_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proof_status": {
          "enum": ["complete", "incomplete"]
        }
      }
    },
    "issue": {
      "type": "object",
      "required": ["severity", "path", "message"],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
