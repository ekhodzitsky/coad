{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/reports/graph-report.schema.json",
  "title": "COAD Graph Report",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "status", "contracts", "issues"],
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": false
        },
        "status": {
          "const": "invalid"
        },
        "contracts": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["ok", "status", "contracts", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true
        },
        "status": {
          "const": "valid"
        },
        "contracts": {
          "type": "integer",
          "minimum": 0
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    }
  ],
  "$defs": {
    "node": {
      "type": "object",
      "required": ["key", "id", "kind", "path"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["source", "target", "relation"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "goal_has_module",
            "goal_has_task",
            "goal_requires_proof",
            "goal_requires_review",
            "goal_integrates_with",
            "task_touches_module",
            "task_requires_proof",
            "review_targets_task",
            "handoff_for_task",
            "integration_has_task",
            "integration_orders_task"
          ]
        }
      }
    },
    "issue": {
      "type": "object",
      "required": ["severity", "path", "message"],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
