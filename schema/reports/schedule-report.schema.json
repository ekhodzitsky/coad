{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/reports/schedule-report.schema.json",
  "title": "COAD Schedule Report",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "ok", "status", "contracts", "issues"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "status": {
          "const": "invalid"
        },
        "contracts": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "ok", "status", "contracts", "goals"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "status": {
          "const": "scheduled"
        },
        "contracts": {
          "type": "integer",
          "minimum": 0
        },
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goal"
          }
        }
      }
    }
  ],
  "$defs": {
    "goal": {
      "type": "object",
      "required": ["goal_id", "path", "max_parallel_agents", "waves", "blocked", "conflicts"],
      "additionalProperties": false,
      "properties": {
        "goal_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "max_parallel_agents": {
          "type": "integer",
          "minimum": 1
        },
        "waves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wave"
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocked_task"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict"
          }
        }
      }
    },
    "wave": {
      "type": "object",
      "required": ["index", "tasks"],
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": ["task_id", "path", "status", "dependencies", "write_scope"],
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "blocked_task": {
      "type": "object",
      "required": ["task_id", "path", "reason"],
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["task_a", "task_b", "type", "scopes"],
      "additionalProperties": false,
      "properties": {
        "task_a": {
          "type": "string",
          "minLength": 1
        },
        "task_b": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["write_scope_overlap", "read_write_overlap"]
        },
        "scopes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "required": ["severity", "path", "message"],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
