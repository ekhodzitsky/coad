{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schemas/lease-manifest.schema.json",
  "title": "COAD Lease Manifest",
  "type": "object",
  "required": ["version", "leases"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "leases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lease"
      },
      "default": []
    }
  },
  "$defs": {
    "lease": {
      "type": "object",
      "required": ["workcell", "owner", "mode"],
      "additionalProperties": false,
      "properties": {
        "workcell": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": ["read", "orchestrate", "write"]
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "proof": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "minLength": 1
        },
        "complete_when": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
