{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/reports/export-report.schema.json",
  "title": "COAD Export Report",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "status",
    "bundle_digest",
    "attestation_bundle_digest",
    "artifact_count",
    "artifacts",
    "issues"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": ["exported", "export_failed"]
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$|^$"
    },
    "attestation_bundle_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$|^$"
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["name", "producer", "path", "required", "ok", "status", "digest", "bytes"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "issue": {
      "type": "object",
      "required": ["severity", "path", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
