{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/reports/pack-error.schema.json",
  "title": "COAD Context Pack Error",
  "type": "object",
  "required": ["schema_version", "ok", "error"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "const": false
    },
    "error": {
      "type": "string",
      "minLength": 1
    }
  }
}
