{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/reports/ledger-handoff-integrity-report.schema.json",
  "title": "COAD Ledger Handoff Integrity Report",
  "type": "object",
  "required": ["schema_version", "ok", "status", "entries", "issues"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": ["pass", "warning", "violation", "skipped"]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ledger_handoff_entry"
      }
    },
    "skip_reason": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "ledger_handoff_entry": {
      "type": "object",
      "required": [
        "ledger_path",
        "event_id",
        "task_id",
        "status",
        "handoff_path",
        "handoff_status",
        "changed_files",
        "ok"
      ],
      "additionalProperties": false,
      "properties": {
        "ledger_path": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "handoff_path": {
          "type": "string"
        },
        "handoff_status": {
          "type": "string"
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ok": {
          "type": "boolean"
        }
      }
    },
    "issue": {
      "type": "object",
      "required": ["code", "severity", "path", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
