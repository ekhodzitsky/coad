{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/release-manifest.schema.json",
  "title": "COAD Release Manifest",
  "type": "object",
  "required": ["schema_version", "release_gates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "command", "working_directory", "required"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "working_directory": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
