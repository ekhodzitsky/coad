{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coad/module-contract.schema.json",
  "title": "COAD Module Contract",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "module",
    "level",
    "purpose",
    "status",
    "surface",
    "dependencies",
    "consumers",
    "invariants",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "module_contract" },
    "module": { "type": "string", "minLength": 1 },
    "level": { "enum": ["root", "subsystem"] },
    "layer": { "type": "string" },
    "purpose": { "type": "string", "minLength": 1 },
    "status": { "enum": ["experimental", "pilot", "stable", "deprecated"] },
    "owners": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "workcell": {
      "type": "object",
      "properties": {
        "type": { "enum": ["project", "composite", "leaf"] },
        "parent": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "owns_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "context_budget": {
          "type": "object",
          "properties": {
            "max_files": { "type": "integer", "minimum": 1 },
            "max_source_lines": { "type": "integer", "minimum": 1 },
            "max_contract_lines": { "type": "integer", "minimum": 1 },
            "max_readme_lines": { "type": "integer", "minimum": 1 },
            "max_todo_lines": { "type": "integer", "minimum": 1 },
            "max_surfaces": { "type": "integer", "minimum": 1 },
            "max_invariants": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "budget_exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason"],
            "properties": {
              "metric": {
                "enum": [
                  "context_budget",
                  "max_files",
                  "max_source_lines",
                  "max_contract_lines",
                  "max_readme_lines",
                  "max_todo_lines",
                  "max_surfaces",
                  "max_invariants"
                ]
              },
              "reason": { "type": "string", "minLength": 1 },
              "expires": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "authority": {
      "type": "object",
      "properties": {
        "write_policy": { "type": "string", "minLength": 1 },
        "orchestrator": { "type": "string" },
        "read_agents": { "type": "string" },
        "migration_lease_required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "surface": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "visibility", "contract", "proof"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "signature": { "type": "string" },
          "kind": { "type": "string", "minLength": 1 },
          "visibility": { "type": "string", "minLength": 1 },
          "contract": { "type": "string", "minLength": 1 },
          "proof": { "$ref": "#/$defs/proof" }
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "object",
      "required": ["internal", "external"],
      "properties": {
        "internal": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["module", "scope", "reason"],
            "properties": {
              "module": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "external": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "scope", "reason"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "uses"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "uses": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule", "proof"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "proof": { "$ref": "#/$defs/proof" }
        },
        "additionalProperties": true
      }
    },
    "verification": {
      "type": "object",
      "required": ["pre_change", "full"],
      "properties": {
        "pre_change": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "full": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "agent_policy": {
      "type": "object",
      "properties": {
        "allowed_mutations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbidden_mutations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "escalation": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "proof": {
      "type": "object",
      "required": ["kind", "target", "command"],
      "properties": {
        "kind": {
          "enum": [
            "unit-test",
            "integration-test",
            "contract-test",
            "golden",
            "schema",
            "static-check",
            "smoke",
            "benchmark",
            "security-scan",
            "review",
            "manual",
            "missing"
          ]
        },
        "target": { "type": "string" },
        "command": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
