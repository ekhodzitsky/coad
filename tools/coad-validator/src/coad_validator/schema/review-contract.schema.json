{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coad/review-contract.schema.json",
  "title": "COAD Review Contract",
  "type": "object",
  "required": ["schema_version", "kind", "review_id", "target_task", "required_reviewers", "acceptance", "outputs"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "review_contract" },
    "review_id": { "type": "string", "minLength": 1 },
    "target_task": { "type": "string", "minLength": 1 },
    "required_reviewers": { "type": "array", "minItems": 1 },
    "findings": { "type": "object", "additionalProperties": true },
    "acceptance": { "type": "object", "additionalProperties": true },
    "outputs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
