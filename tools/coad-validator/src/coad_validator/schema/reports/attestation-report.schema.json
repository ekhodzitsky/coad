{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/reports/attestation-report.schema.json",
  "title": "COAD Attestation Report",
  "type": "object",
  "required": ["schema_version", "ok", "status", "bundle_digest", "reports", "issues"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": ["attested", "attestation_failed"]
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$|^$"
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/report"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "report": {
      "type": "object",
      "required": ["name", "producer", "required", "ok", "status", "digest"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "issue": {
      "type": "object",
      "required": ["severity", "path", "message"],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
