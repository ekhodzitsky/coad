{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/reports/methodology-loop-report.schema.json",
  "title": "COAD Methodology Loop Report",
  "type": "object",
  "required": ["schema_version", "claim", "limitations", "ok", "status", "phases", "issues"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claim": {
      "const": "methodology_evidence"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": ["pass", "partial", "missing", "unknown", "skipped"]
    },
    "phases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "skip_reason": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": [
        "name",
        "status",
        "summary",
        "evidence",
        "source_reports",
        "blocking_issues",
        "recommended_fix",
        "issues"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": ["orient", "scope", "execute", "prove", "update_knowledge", "handoff"]
        },
        "status": {
          "enum": ["pass", "weak", "missing", "unknown", "skipped"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_reports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocking_issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_fix": {
          "type": "string",
          "minLength": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "required": ["code", "severity", "path", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
