{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/reports/drift-report.schema.json",
  "title": "COAD Drift Report",
  "type": "object",
  "required": ["schema_version", "ok", "status", "issues"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": ["clean", "drift"]
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "required": ["severity", "path", "message"],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
