{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coad/handoff-contract.schema.json",
  "title": "COAD Handoff Contract",
  "type": "object",
  "required": ["schema_version", "kind", "task_id", "status", "changed_files", "proof_results", "contract_updates", "known_gaps"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "handoff_contract" },
    "task_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["complete", "not_ready", "blocked_on_human", "blocked_on_external", "failed_infra", "cancelled"] },
    "changed_files": { "type": "array" },
    "proof_results": { "type": "array" },
    "contract_updates": { "type": "array" },
    "decisions": { "type": "array" },
    "known_gaps": { "type": "array" },
    "follow_up_tasks": { "type": "array" }
  },
  "additionalProperties": true
}
