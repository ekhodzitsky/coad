{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/report-manifest.schema.json",
  "title": "COAD Report Manifest",
  "type": "object",
  "required": ["schema_version", "reports"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "producer",
          "schema",
          "report_schema_version",
          "stability"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "pattern": "^reports/.+\\.schema\\.json$"
          },
          "report_schema_version": {
            "const": 1
          },
          "stability": {
            "enum": ["stable", "experimental"]
          }
        }
      }
    }
  }
}
