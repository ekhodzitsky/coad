{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coad.dev/schema/conformance-profile.schema.json",
  "title": "COAD Conformance Profile",
  "type": "object",
  "required": ["schema_version", "kind", "profile_id", "level", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "conformance_profile"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "contracts_validated",
        "schedulable_orchestration",
        "proof_gated_execution",
        "ledger_audited_orchestration",
        "release_gated_readiness"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "tool", "required", "description"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
