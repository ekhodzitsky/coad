{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coad/proof-contract.schema.json",
  "title": "COAD Proof Contract",
  "type": "object",
  "required": ["schema_version", "kind", "proof_id", "claim", "required"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "proof_contract" },
    "proof_id": { "type": "string", "minLength": 1 },
    "claim": { "type": "string", "minLength": 1 },
    "required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "target", "command", "blocks_readiness"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "target": { "type": "string" },
          "command": { "type": "string" },
          "blocks_readiness": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "accepted_missing": { "type": "array" },
    "artifacts": { "type": "array" }
  },
  "additionalProperties": true
}
