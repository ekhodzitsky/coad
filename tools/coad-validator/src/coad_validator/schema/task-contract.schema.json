{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coad/task-contract.schema.json",
  "title": "COAD Task Contract",
  "type": "object",
  "required": ["schema_version", "kind", "task_id", "objective", "owner_role", "status", "risk", "change_class", "modules", "read_scope", "write_scope", "acceptance", "proof", "handoff"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "task_contract" },
    "task_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "owner_role": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "in_progress", "complete", "not_ready", "blocked", "failed", "cancelled"] },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "change_class": { "type": "string", "minLength": 1 },
    "modules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "read_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "write_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "allowed_mutations": { "type": "array", "items": { "type": "string" } },
    "forbidden_mutations": { "type": "array", "items": { "type": "string" } },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "proof": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["proof_id", "kind", "target", "command"],
            "properties": {
              "proof_id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "target": { "type": "string" },
              "command": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "handoff": { "type": "object", "required": ["required_fields"], "additionalProperties": true }
  },
  "additionalProperties": true
}
